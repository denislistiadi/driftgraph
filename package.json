{
  "name": "driftgraph",
  "version": "1.0.3",
  "description": "Custom GitHub Action for automated architecture visualization and gatekeeping",
  "main": "dist/index.js",
  "scripts": {
    "build": "ncc build src/index.ts -o dist",
    "typecheck": "tsc --noEmit",
    "typecheck:test": "tsc -p tsconfig.test.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepare": "husky"
  },
  "keywords": [
    "architecture",
    "github-action",
    "typescript",
    "dependency-graph",
    "mermaid"
  ],
  "author": "Denis Listiadi",
  "license": "ISC",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/denislistiadi/driftgraph.git"
  },
  "bugs": {
    "url": "https://github.com/denislistiadi/driftgraph/issues"
  },
  "homepage": "https://github.com/denislistiadi/driftgraph#readme",
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "@actions/core": "^1.11.1",
    "@actions/exec": "^1.1.1",
    "@actions/github": "^6.0.1",
    "fast-glob": "^3.3.3",
    "minimatch": "^9.0.3",
    "ts-morph": "^21.0.1",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@vercel/ncc": "^0.38.4",
    "husky": "^9.1.7",
    "typescript": "^5.9.3",
    "vitest": "^5.0.5"
  },
  "overrides": {
    "@actions/http-client": "3.0.2",
    "undici": "6.29.1"
  }
}
